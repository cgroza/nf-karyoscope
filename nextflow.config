manifest {
    name = 'cgroza/nf-karyoscope'
    description = 'KaryoScope annotation of haplotype-resolved assemblies'
    mainScript = 'main.nf'
    version = '0.1.0'
    nextflowVersion = '>=25.10.0'
    homePage = 'https://github.com/cgroza/nf-karyoscope'
}

params {
    input = null
    outdir = 'results'
    db = 'HKS_human_CHM13_v2'
    db_dir = null
    feature_sets = null
    smooth = true
    keep_presmoothed = true
    bgzip = true
    cpus = 16
    memory = '16 GB'
    time = '4h'
    max_parallel = 2
    container = 'nf-karyoscope:0.1.0'
    help = false
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    withName: ANNOTATE {
        publishDir = [
            path: { "${params.outdir}/annotations/${meta.sample}/${meta.haplotype}" },
            mode: 'copy',
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        process.container = params.container
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.container = "docker://${params.container}"
    }
    local {
        docker.enabled = false
        apptainer.enabled = false
    }
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
